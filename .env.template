# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_NAME="Algorithmic Trading ML"

# Database Configuration
DATABASE_URL=postgresql://trading_user:trading_password@localhost:5432/trading_db

# Redis Configuration  
REDIS_URL=redis://localhost:6379/0

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000

# API Keys (Required for data collection)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
NEWSAPI_KEY=your_newsapi_key_here

# Trading Parameters
INITIAL_CAPITAL=100000.0
MAX_POSITION_SIZE=0.05
MAX_SECTOR_EXPOSURE=0.20
MAX_DRAWDOWN_THRESHOLD=0.10

# Risk Management
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.10

# Data Collection
DATA_COLLECTION_INTERVAL=3600
API_RATE_LIMIT_PER_MINUTE=5

# Model Training
MODEL_RETRAIN_INTERVAL_DAYS=7
CROSS_VALIDATION_FOLDS=3

# Feature Engineering
TECHNICAL_INDICATORS_WINDOW=20

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log
